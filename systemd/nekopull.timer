[Unit]
Description=Run nekopull daily

[Timer]
OnCalendar=*-*-* 04:00:00
# Run once shortly after the timer is activated, i.e. after `enable --now` and
# after every login, so a keyring password can be entered while you are there.
# The unlock has to survive until the calendar run: gpg-agent's cache lifetime
# must be longer than the gap (see README).
OnActiveSec=1min
Persistent=true

[Install]
WantedBy=timers.target
